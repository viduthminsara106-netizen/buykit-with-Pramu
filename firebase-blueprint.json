          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the recipient shopper.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Notification inbox category tab.",
          "enum": ["orders", "promos", "activity", "system"],
          "minLength": 1,
          "maxLength": 24
        },
        "eventType": {
          "type": "string",
          "description": "Specific storefront event that triggered this notification.",
          "enum": [
            "order_placed",
            "order_preparing",
            "order_dispatched",
            "order_in_transit",
            "order_shipped",
            "order_delivered",
            "order_cancelled",
            "voucher_claimed",
            "flash_sale",
            "wishlist_saved",
            "question_answered",
            "review_posted",
            "welcome",
            "admin_broadcast"
          ],
          "minLength": 1,
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "description": "Concise notification headline.",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "description": "Notification body message.",
          "minLength": 1,
          "maxLength": 500
        },
        "actionType": {
          "type": "string",
          "description": "Navigation action triggered when the shopper taps this notification.",
          "enum": ["open_order", "open_product", "open_coupons", "open_deals", "open_cart", "none"],
          "minLength": 1,
          "maxLength": 24
        },
        "relatedId": {
          "type": "string",
          "description": "Related order ID, product ID, or general identifier.",
          "minLength": 0,
          "maxLength": 128
        },
        "trackingNumber": {
          "type": "string",
          "description": "Optional tracking number associated with an order notification.",
          "minLength": 0,
          "maxLength": 40
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional product thumbnail URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "read": {
          "type": "boolean",
          "description": "Whether the shopper has read this notification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the notification was created."
        }
      },
      "required": ["notificationId", "userId", "category", "eventType", "title", "message", "actionType", "relatedId", "trackingNumber", "imageUrl", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Stores public profile and new-user voucher status for each authenticated user."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Stores isolated PII (email, phone, shipping address) strictly accessible only by the owner."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Stores individual shopping cart line items belonging to the authenticated user."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Stores purchase orders placed by the authenticated user."
    },
    "/users/{userId}/wishlist/{itemId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Stores saved wishlist products belonging to the authenticated user."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotificationRecord" },
      "description": "Stores real-time customer notifications for orders, shipping updates, vouchers, and activity."
    },
    "/product_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Stores 5-star customer reviews with text, image, video, and voice media for marketplace products."
    },
    "/review_replies/{replyId}": {
      "schema": { "$ref": "#/entities/ReviewReply" },
      "description": "Stores user replies to product reviews."
    },
    "/product_questions/{questionId}": {
      "schema": { "$ref": "#/entities/ProductQuestion" },
      "description": "Stores customer questions asked on individual products."
    },
    "/question_answers/{answerId}": {
      "schema": { "$ref": "#/entities/QuestionAnswer" },
      "description": "Stores official admin-only answers to customer product questions."
    },
    "/admin_emails/{adminEmailId}": {
      "schema": { "$ref": "#/entities/AdminEmailRecord" },
      "description": "Stores dynamic list of Gmail addresses granted Admin Dashboard privileges."
    },
    "/admin_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotificationRecord" },
      "description": "Stores real-time storefront activity notifications visible exclusively to admins."
    },
    "/admin_orders/{orderId}": {
      "schema": { "$ref": "#/entities/AdminOrderRecord" },
      "description": "Stores global order tracking records across all customers for Admin Dashboard fulfillment management."
    }
  }
}
