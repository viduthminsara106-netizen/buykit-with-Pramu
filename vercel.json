{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|src/assets/|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*|pwa-.*\\.png|apple-touch-icon\\.png|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
