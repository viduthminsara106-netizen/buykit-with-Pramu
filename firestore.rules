rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function emailToAdminKey(email) {
      return email.lower().replace('[^a-z0-9]', '_');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email.lower() == 'viduthminsara106@gmail.com' ||
        request.auth.token.email.lower() == 'pramudithamanuja853@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_emails/$(emailToAdminKey(request.auth.token.email)))
      );
    }

    function userParentExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function reviewParentExists(reviewId) {
      return exists(/databases/$(database)/documents/product_reviews/$(reviewId));
    }

    function questionParentExists(questionId) {
      return exists(/databases/$(database)/documents/product_questions/$(questionId));
    }

    // Blueprint Validation Helpers
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'photoUrl', 'newUserDealClaimed', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'photoUrl', 'newUserDealClaimed', 'createdAt', 'updatedAt']) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.photoUrl is string && data.photoUrl.size() <= 500 &&
        data.newUserDealClaimed is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['userId', 'email', 'phone', 'shippingAddress', 'postalCode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'email', 'phone', 'shippingAddress', 'postalCode', 'createdAt', 'updatedAt']) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300 &&
        data.postalCode is string && data.postalCode.size() >= 2 && data.postalCode.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['userId', 'productId', 'title', 'category', 'dealType', 'price', 'originalPrice', 'quantity', 'imageUrl', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'productId', 'title', 'category', 'dealType', 'price', 'originalPrice', 'quantity', 'imageUrl', 'createdAt', 'updatedAt']) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.productId is string && isValidId(data.productId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.dealType is string && data.dealType.size() >= 1 && data.dealType.size() <= 30 &&
        data.dealType in ['new_user', 'flash_sale', 'choice_bundle', 'standard'] &&
        data.price is number && data.price >= 0 && data.price <= 50000000 &&
        data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000000 &&
        data.quantity is number && data.quantity >= 1 && data.quantity <= 99 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrderRecord(data) {
      return data.keys().hasAll(['userId', 'orderNumber', 'summaryTitle', 'itemCount', 'totalAmount', 'paymentMethod', 'pickupHubName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'orderNumber', 'trackingNumber', 'summaryTitle', 'itemCount', 'totalAmount', 'paymentMethod', 'pickupHubName', 'status', 'createdAt', 'updatedAt']) &&
        data.userId is string && isValidId(data.userId) && (data.userId == request.auth.uid || isAdmin()) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() >= 8 && data.trackingNumber.size() <= 40 && data.trackingNumber.matches('^[A-Z0-9\\-]+$'))) &&
        data.summaryTitle is string && data.summaryTitle.size() >= 1 && data.summaryTitle.size() <= 200 &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 500000000 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 30 &&
        data.paymentMethod in ['cod', 'card_express'] &&
        data.pickupHubName is string && data.pickupHubName.size() >= 2 && data.pickupHubName.size() <= 120 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 30 &&
        data.status in ['processing', 'preparing', 'dispatched', 'in_transit', 'shipped', 'delivered', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['userId', 'productId', 'title', 'category', 'dealType', 'price', 'originalPrice', 'imageUrl', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'productId', 'title', 'category', 'dealType', 'price', 'originalPrice', 'imageUrl', 'createdAt', 'updatedAt']) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.productId is string && isValidId(data.productId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.dealType is string && data.dealType.size() >= 1 && data.dealType.size() <= 30 &&
        data.dealType in ['new_user', 'flash_sale', 'choice_bundle', 'standard'] &&
        data.price is number && data.price >= 0 && data.price <= 50000000 &&
        data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000000 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductReview(data) {
      return data.keys().hasAll(['reviewId', 'productId', 'userId', 'userName', 'userPhotoUrl', 'rating', 'comment', 'imageUrl', 'videoUrl', 'voiceUrl', 'verifiedPurchase', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reviewId', 'productId', 'userId', 'userName', 'userPhotoUrl', 'rating', 'comment', 'imageUrl', 'videoUrl', 'voiceUrl', 'verifiedPurchase', 'visibility', 'createdAt', 'updatedAt']) &&
        data.reviewId is string && isValidId(data.reviewId) &&
        data.productId is string && isValidId(data.productId) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.userPhotoUrl is string && data.userPhotoUrl.size() <= 500 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1500 &&
        data.imageUrl is string && data.imageUrl.size() <= 200000 &&
        data.videoUrl is string && data.videoUrl.size() <= 200000 &&
        data.voiceUrl is string && data.voiceUrl.size() <= 200000 &&
        data.verifiedPurchase is bool &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReviewReply(data) {
      return data.keys().hasAll(['replyId', 'reviewId', 'productId', 'userId', 'userName', 'comment', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['replyId', 'reviewId', 'productId', 'userId', 'userName', 'comment', 'visibility', 'createdAt', 'updatedAt']) &&
        data.replyId is string && isValidId(data.replyId) &&
        data.reviewId is string && isValidId(data.reviewId) &&
        data.productId is string && isValidId(data.productId) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductQuestion(data) {
      return data.keys().hasAll(['questionId', 'productId', 'userId', 'userName', 'questionText', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['questionId', 'productId', 'userId', 'userName', 'questionText', 'visibility', 'createdAt', 'updatedAt']) &&
        data.questionId is string && isValidId(data.questionId) &&
        data.productId is string && isValidId(data.productId) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.questionText is string && data.questionText.size() >= 2 && data.questionText.size() <= 1000 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionAnswer(data) {
      return data.keys().hasAll(['answerId', 'questionId', 'productId', 'userId', 'userName', 'answerText', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['answerId', 'questionId', 'productId', 'userId', 'userName', 'answerText', 'visibility', 'createdAt', 'updatedAt']) &&
        data.answerId is string && isValidId(data.answerId) &&
        data.questionId is string && isValidId(data.questionId) &&
        data.productId is string && isValidId(data.productId) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.answerText is string && data.answerText.size() >= 1 && data.answerText.size() <= 1000 &&
        data.visibility is string && data.visibility.size() == 6 && data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminEmailRecord(data) {
      return data.keys().hasAll(['adminEmailId', 'email', 'addedByEmail', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['adminEmailId', 'email', 'addedByEmail', 'role', 'createdAt', 'updatedAt']) &&
        data.adminEmailId is string && isValidId(data.adminEmailId) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.addedByEmail is string && data.addedByEmail.size() >= 5 && data.addedByEmail.size() <= 160 &&
        data.role is string && data.role == 'admin' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminNotification(data) {
      return data.keys().hasAll(['notificationId', 'type', 'title', 'message', 'actorUserId', 'actorName', 'actorEmail', 'relatedId', 'read', 'createdAt']) &&
        data.keys().hasOnly(['notificationId', 'type', 'title', 'message', 'actorUserId', 'actorName', 'actorEmail', 'relatedId', 'read', 'createdAt']) &&
        data.notificationId is string && isValidId(data.notificationId) &&
        data.type is string && data.type in ['cart_add', 'order_placed', 'review_added', 'question_asked', 'sale_started', 'sale_ended', 'promo_updated', 'system'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.actorUserId is string && isValidId(data.actorUserId) && (data.actorUserId == request.auth.uid || isAdmin()) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
        data.actorEmail is string && data.actorEmail.size() <= 160 &&
        data.relatedId is string && data.relatedId.size() <= 128 &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidAdminOrderRecord(data) {
      return data.keys().hasAll(['orderId', 'userId', 'orderNumber', 'customerName', 'customerEmail', 'customerPhone', 'shippingAddress', 'summaryTitle', 'itemCount', 'totalAmount', 'paymentMethod', 'paymentLabel', 'pickupHubName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['orderId', 'userId', 'orderNumber', 'trackingNumber', 'customerName', 'customerEmail', 'customerPhone', 'shippingAddress', 'summaryTitle', 'itemCount', 'totalAmount', 'paymentMethod', 'paymentLabel', 'pickupHubName', 'status', 'createdAt', 'updatedAt']) &&
        data.orderId is string && isValidId(data.orderId) &&
        data.userId is string && isValidId(data.userId) && (data.userId == request.auth.uid || isAdmin()) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() >= 8 && data.trackingNumber.size() <= 40 && data.trackingNumber.matches('^[A-Z0-9\\-]+$'))) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        data.customerEmail is string && data.customerEmail.size() <= 160 &&
        data.customerPhone is string && data.customerPhone.size() <= 40 &&
        data.shippingAddress is string && data.shippingAddress.size() <= 300 &&
        data.summaryTitle is string && data.summaryTitle.size() >= 1 && data.summaryTitle.size() <= 200 &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 500 &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 500000000 &&
        data.paymentMethod is string && data.paymentMethod in ['cod', 'card_express'] &&
        data.paymentLabel is string && data.paymentLabel.size() >= 1 && data.paymentLabel.size() <= 140 &&
        data.pickupHubName is string && data.pickupHubName.size() >= 2 && data.pickupHubName.size() <= 120 &&
        data.status is string && data.status in ['processing', 'preparing', 'dispatched', 'in_transit', 'shipped', 'delivered', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserNotification(data) {
      return data.keys().hasAll(['notificationId', 'userId', 'category', 'eventType', 'title', 'message', 'actionType', 'relatedId', 'trackingNumber', 'imageUrl', 'read', 'createdAt']) &&
        data.keys().hasOnly(['notificationId', 'userId', 'category', 'eventType', 'title', 'message', 'actionType', 'relatedId', 'trackingNumber', 'imageUrl', 'read', 'createdAt']) &&
        data.notificationId is string && isValidId(data.notificationId) &&
        data.userId is string && isValidId(data.userId) && (data.userId == request.auth.uid || isAdmin()) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 24 &&
        data.category in ['orders', 'promos', 'activity', 'system'] &&
        data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 32 &&
        data.eventType in ['order_placed', 'order_preparing', 'order_dispatched', 'order_in_transit', 'order_shipped', 'order_delivered', 'order_cancelled', 'voucher_claimed', 'flash_sale', 'wishlist_saved', 'question_answered', 'review_posted', 'welcome', 'admin_broadcast'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 24 &&
        data.actionType in ['open_order', 'open_product', 'open_coupons', 'open_deals', 'open_cart', 'none'] &&
        data.relatedId is string && data.relatedId.size() <= 128 &&
        data.trackingNumber is string && data.trackingNumber.size() <= 40 &&
        data.imageUrl is string && data.imageUrl.size() <= 500 &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    // Admins UID lookup collection (read-only for owner/admin)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Dynamic Admin Gmail Collection (Root Admin viduthminsara106@gmail.com & added admins)
    match /admin_emails/{adminEmailId} {
      allow get: if isVerifiedUser() && isValidId(adminEmailId) && (adminEmailId == emailToAdminKey(request.auth.token.email) || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(adminEmailId) &&
        isValidAdminEmailRecord(incoming()) &&
        incoming().adminEmailId == adminEmailId &&
        incoming().adminEmailId == emailToAdminKey(incoming().email) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(adminEmailId) &&
        isValidAdminEmailRecord(incoming()) &&
        incoming().adminEmailId == existing().adminEmailId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() &&
        isValidId(adminEmailId) &&
        existing().email.lower() != 'viduthminsara106@gmail.com' &&
        existing().email.lower() != 'pramudithamanuja853@gmail.com';
    }

    // Real-Time Admin Notifications Collection (Strictly Admin-only reads & updates)
    match /admin_notifications/{notificationId} {
      allow get: if isAdmin() && isValidId(notificationId);
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidAdminNotification(incoming()) &&
        incoming().notificationId == notificationId &&
        incoming().actorUserId == request.auth.uid &&
        incoming().read == false &&
        incoming().createdAt == request.time;

      allow update: if isAdmin() &&
        isValidId(notificationId) &&
        isValidAdminNotification(incoming()) &&
        incoming().notificationId == existing().notificationId &&
        incoming().actorUserId == existing().actorUserId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // Global Admin Order Tracking Collection (All users' orders visible & manageable by Admin)
    match /admin_orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidAdminOrderRecord(incoming()) &&
        incoming().orderId == orderId &&
        incoming().userId == request.auth.uid &&
        incoming().status in ['processing', 'preparing'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(orderId) &&
        isValidAdminOrderRecord(incoming()) &&
        incoming().orderId == existing().orderId &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isVerifiedUser() && existing().userId == request.auth.uid &&
            (existing().status == 'processing' || existing().status == 'preparing') &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 1. User Public Profile
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'newUserDealClaimed', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidId(userId);

      // 2. Isolated Private PII Subcollection
      match /private/{docId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(docId) && userParentExists(userId);
        allow list: if false;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userParentExists(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          userParentExists(userId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'shippingAddress', 'postalCode', 'updatedAt'])
          );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }

      // 3. Shopping Cart Subcollection (Strictly for Registered/Authenticated Users)
      match /cart/{itemId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && userParentExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(itemId) &&
          isValidCartItem(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userParentExists(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(itemId) &&
          isValidCartItem(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().productId == existing().productId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          userParentExists(userId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'price', 'dealType', 'updatedAt'])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && userParentExists(userId);
      }

      // 4. Orders Subcollection (Admin can read & update status of any customer's order)
      match /orders/{orderId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(orderId) && userParentExists(userId);
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(orderId) &&
          isValidOrderRecord(incoming()) &&
          incoming().status in ['processing', 'preparing'] &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userParentExists(userId);

        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(userId) &&
          isValidId(orderId) &&
          isValidOrderRecord(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().orderNumber == existing().orderNumber &&
          incoming().totalAmount == existing().totalAmount &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          userParentExists(userId) && (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            ((existing().status == 'processing' || existing().status == 'preparing') &&
              incoming().status == 'cancelled' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(orderId);
      }

      // 5. Wishlist Subcollection
      match /wishlist/{itemId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && userParentExists(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(itemId) &&
          isValidWishlistItem(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userParentExists(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(itemId) &&
          isValidWishlistItem(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().productId == existing().productId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          userParentExists(userId) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['price', 'originalPrice', 'dealType', 'updatedAt'])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && userParentExists(userId);
      }

      // 5B. Customer Real-Time Notifications Subcollection (Owner reads/marks read/deletes; Owner & Admin can push)
      match /notifications/{notificationId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(notificationId) && userParentExists(userId);
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();

        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(userId) &&
          isValidId(notificationId) &&
          isValidUserNotification(incoming()) &&
          incoming().notificationId == notificationId &&
          incoming().userId == userId &&
          incoming().read == false &&
          incoming().createdAt == request.time &&
          userParentExists(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(notificationId) &&
          isValidUserNotification(incoming()) &&
          incoming().notificationId == existing().notificationId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          userParentExists(userId);

        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(notificationId) && userParentExists(userId);
      }
    }

    // 6. Product Reviews Collection
    match /product_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidProductReview(incoming()) &&
        incoming().reviewId == reviewId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid);

      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidProductReview(incoming()) &&
        incoming().reviewId == existing().reviewId &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid) && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'imageUrl', 'videoUrl', 'voiceUrl', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Review Replies Collection
    match /review_replies/{replyId} {
      allow get: if isValidId(replyId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(replyId) &&
        isValidReviewReply(incoming()) &&
        incoming().replyId == replyId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid) &&
        reviewParentExists(incoming().reviewId);

      allow update: if isVerifiedUser() &&
        isValidId(replyId) &&
        isValidReviewReply(incoming()) &&
        incoming().replyId == existing().replyId &&
        incoming().reviewId == existing().reviewId &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid) &&
        reviewParentExists(existing().reviewId) && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(replyId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 8. Product Questions Collection (Shoppers can ask questions)
    match /product_questions/{questionId} {
      allow get: if isValidId(questionId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidProductQuestion(incoming()) &&
        incoming().questionId == questionId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid);

      allow update: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidProductQuestion(incoming()) &&
        incoming().questionId == existing().questionId &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        userParentExists(request.auth.uid) && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['questionText', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(questionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 9. Question Answers Collection (STRICTLY ADMIN-ONLY ANSWERS)
    match /question_answers/{answerId} {
      allow get: if isValidId(answerId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isAdmin() &&
        isValidId(answerId) &&
        isValidQuestionAnswer(incoming()) &&
        incoming().answerId == answerId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        questionParentExists(incoming().questionId);

      allow update: if isAdmin() &&
        isValidId(answerId) &&
        isValidQuestionAnswer(incoming()) &&
        incoming().answerId == existing().answerId &&
        incoming().questionId == existing().questionId &&
        incoming().productId == existing().productId &&
        incoming().userId == existing().userId &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        questionParentExists(existing().questionId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['answerText', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(answerId);
    }
  }
}
